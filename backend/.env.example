# Xero MCP Chatbot Backend Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="Xero MCP Chatbot Backend"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT="production"

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST="0.0.0.0"
PORT=8000
RELOAD=false

# =============================================================================
# CORS SETTINGS
# =============================================================================
CORS_ORIGINS="http://localhost:3000,https://your-frontend-domain.com"
CORS_CREDENTIALS=true
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_HEADERS="*"

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# XERO OAUTH2 CONFIGURATION
# =============================================================================
XERO_CLIENT_ID="your-xero-client-id"
XERO_CLIENT_SECRET="your-xero-client-secret"
XERO_REDIRECT_URI="http://localhost:8000/auth/callback"
XERO_SCOPE="accounting.transactions accounting.contacts accounting.reports.read"

# =============================================================================
# MCP SERVER CONFIGURATION
# =============================================================================
# JSON-RPC 2.0 Protocol Settings (NON-NEGOTIABLE per Constitution)
MCP_SERVER_URL="http://localhost:8080"
MCP_TIMEOUT=30
MCP_MAX_RETRIES=3
MCP_PROTOCOL_VERSION="2.0"

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL="INFO"
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE="logs/backend.log"

# =============================================================================
# DATABASE SETTINGS (Future Extension)
# =============================================================================
# DATABASE_URL="sqlite:///./xero_chatbot.db"
# DATABASE_ECHO=false

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Set to true for development environment
DEV_MODE=false
DEV_CORS_ALLOW_ALL=false
DEV_LOG_REQUESTS=false